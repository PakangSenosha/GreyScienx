{
  "name": "greyscienx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:validate": "node scripts/validate-live-deployment.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "casino:test": "node --test research/experiments/virtual-casino/tests/*.test.mjs",
    "casino:generate": "node research/experiments/virtual-casino/scripts/generate-artifacts.mjs",
    "casino:replay": "node research/experiments/virtual-casino/scripts/replay.mjs",
    "casino:make-it-big:test": "node --test research/experiments/virtual-casino/make-it-big/tests/*.test.mjs",
    "casino:make-it-big:generate": "node research/experiments/virtual-casino/make-it-big/scripts/generate-artifacts.mjs",
    "research:compile": "node research/templates/semantic-twin/compile.mjs",
    "research:compile-profiles": "node research/templates/semantic-twin/compile-profiles.mjs",
    "research:test": "node --import ./scripts/register-ts.mjs --test lib/research/registry.test.mjs",
    "research:verify": "npm run research:compile && node --import ./scripts/register-ts.mjs scripts/verify-research-corpus.mjs",
    "research:check": "npm run research:reproduce && npm run research:verify && npm run research:audit-twins && npm run research:audit-visuals && npm run research:test",
    "research:publish-review": "node --import ./scripts/register-ts.mjs scripts/publish-review.mjs",
    "research:reproduce": "node scripts/reproduce-models.mjs",
    "research:check-links": "node --import ./scripts/register-ts.mjs scripts/check-research-links.mjs",
    "research:audit-twins": "node scripts/audit-manuscript-twins.mjs",
    "research:audit-visuals": "node scripts/audit-pdf-visuals.mjs",
    "research:suggest-sources": "node scripts/suggest-claim-sources.mjs"
  },
  "dependencies": {
    "@ai-sdk/xai": "^4.0.57",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "ai": "^7.0.97",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.10",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.8"
  },
  "type": "module"
}
