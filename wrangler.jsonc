{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greyscienx",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "greyscienx.com/*",
      "zone_name": "greyscienx.com"
    },
    {
      "pattern": "www.greyscienx.com",
      "custom_domain": true
    }
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "account_id": "e314eecf0fd1248880037f6dc392e4ec",
  "kv_namespaces": [
    {
      "binding": "REVIEW_QUEUE",
      "id": "74aa1d3995d64ca6837a65465f2cfd22"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
